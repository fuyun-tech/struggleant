{
  "name": "struggleant",
  "version": "2.0.1",
  "description": "Website of struggleant.com",
  "keywords": [
    "Magazine",
    "CMS",
    "AI CMS",
    "Wutong CMS",
    "Angular",
    "Angular SSR",
    "SSR",
    "Fuyun"
  ],
  "author": {
    "name": "Fuyun",
    "url": "https://www.struggleant.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/fuyun-tech/struggleant#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fuyun-tech/struggleant.git"
  },
  "bugs": {
    "url": "https://github.com/fuyun-tech/struggleant/issues"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build:ng": "ng build",
    "build:gulp": "gulp build",
    "build:prod": "npm run build:ng && npm run build:gulp",
    "build:zip": "bash ./scripts/zip.sh",
    "build": "npm run build:prod && npm run build:zip",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint \"src/**/*.{ts,html}\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "deploy": "bash ./scripts/deploy.sh",
    "deploy:local": "bash ./scripts/deploy-local.sh",
    "deploy:zip": "bash ./scripts/deploy-manual.sh",
    "cloc": "cloc --exclude-dir=.git,.idea,.vscode,node_modules,dist,test,package-lock.json,.angular,.github,.nx ."
  },
  "dependencies": {
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/platform-server": "^22.1.3",
    "@angular/router": "^22.1.3",
    "@angular/ssr": "^22.1.5",
    "@fuyun/feed": "^1.0.0",
    "@microsoft/fetch-event-source": "^2.0.1",
    "express": "^5.2.1",
    "highlight.js": "^11.12.0",
    "lazysizes": "^5.3.2",
    "lodash": "^4.18.1",
    "marked": "^18.0.10",
    "murmurhash": "^2.0.1",
    "ng-zorro-antd": "^22.0.1",
    "ngx-clipboard": "^16.0.0",
    "rxjs": "^7.8.2",
    "sitemap": "^9.0.1",
    "tslib": "^2.8.1",
    "ua-parser-js": "^2.0.10"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.2.0",
    "@types/ua-parser-js": "^0.7.39",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "gulp": "^4.0.2",
    "gulp-gzip": "^1.4.2",
    "less": "^4.9.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
